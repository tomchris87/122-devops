resource "aws_vpc" "vpc1" {
    cidr_block = "172.16.0.0/16"
    tags= {
        Name = "wipro-vpc"
        Owner = "tom"
    }
}
resource "aws_subnet" "public-sub" {
    vpc_id = aws_vpc.vpc1.id
    cidr_block = "172.16.0.0/24"
    tags= {
        Name = "prod-db-sub-01"
    }
}
resource "aws_subnet" "private-sub" {
    vpc_id = aws_vpc.vpc1.id
    cidr_block = "172.16.1.0/24"
    tags= {
        Name = "prod-db-sub-02"
    }
}
